<% content_for :title, "Cart" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center border border-black p-5 mb-5 bg-green-100 rounded-2xl">
    <h1 class="font-bold text-4xl">Cart</h1>
  </div>

  <div id="cart" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @cart.cart_items.any? %>
      <%= button_to "Empty cart", cart_path, method: :delete, class: "rounded-md px-3.5 py-2.5 bg-orange-600 hover:bg-orange-500 text-white block font-medium w-full" %>

      <% @cart.cart_items.each do |cart_item| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0 bg-emerald-300 rounded-xl p-5">
          <div class="w-full sm:w-auto my-5 space-y-5 ">
            <%= cart_item.drink.name %>
          </div>

          <div>
            Quantity: <%= cart_item.quantity %>
          </div>

          <%= button_to "Remove", remove_item_from_cart_path(cart_item.drink), method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer"%>

        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">Your cart is empty</p>
    <% end %>

    <div class="mt-4 text-sm text-gray-500 sm:mt-0">
      <%= link_to "Add drinks", drinks_path, class: "text-gray-700 underline hover:no-underline" %>
    </div>
  </div>
</div>
